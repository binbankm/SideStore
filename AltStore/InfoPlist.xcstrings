    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SideStore can use local network access to discover Bonjour (mDNS) services on your network. This is not required for core functionality."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SideStore 可使用本地网络权限在您的网络中发现 Bonjour (mDNS) 服务。核心功能并不强制需要此权限。"
          }
        }
      }
    },
